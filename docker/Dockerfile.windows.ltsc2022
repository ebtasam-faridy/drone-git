# escape=`

# Stage 1: Fetch Git + Git LFS + OpenSSH
FROM mcr.microsoft.com/windows/servercore:ltsc2022 AS builder
SHELL ["powershell", "-Command", "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue';"]

# Download minimal Git for Windows (MinGit)
RUN Invoke-WebRequest -Uri "https://github.com/git-for-windows/git/releases/download/v2.45.2.windows.1/MinGit-2.45.2-64-bit.zip" -OutFile "C:\\git.zip"; `
    Expand-Archive "C:\\git.zip" -DestinationPath "C:\\git"; `
    Remove-Item "C:\\git.zip" -Force

# Download Git LFS
RUN Invoke-WebRequest -Uri "https://github.com/git-lfs/git-lfs/releases/download/v3.5.1/git-lfs-windows-amd64-v3.5.1.zip" -OutFile "C:\\git-lfs.zip"; `
    Expand-Archive "C:\\git-lfs.zip" -DestinationPath "C:\\git-lfs"; `
    Remove-Item "C:\\git-lfs.zip" -Force

# Install OpenSSH client
RUN Add-WindowsCapability -Online -Name OpenSSH.Client~~~~0.0.1.0

# Clean up unnecessary Windows updates cache
RUN Remove-Item -Recurse -Force C:\\Windows\\Temp\\* , C:\\Users\\*\\AppData\\Local\\Temp\\*


# Stage 2: Final image
FROM mcr.microsoft.com/powershell:ltsc2022
SHELL ["pwsh", "-Command", "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue';"]

# Copy only what's required from builder stage
COPY --from=builder C:\\git C:\\git
COPY --from=builder C:\\git-lfs C:\\git-lfs
COPY --from=builder C:\\Windows\\System32\\OpenSSH C:\\Windows\\System32\\OpenSSH

# Add scripts from repo
ADD windows/* C:\\bin\\

# Add Git, PowerShell, OpenSSH, and Git LFS to PATH
USER ContainerAdministrator
RUN setx /M PATH "C:\\Program Files\\PowerShell;C:\\git\\cmd;C:\\git\\mingw64\\bin;C:\\git\\usr\\bin;C:\\Windows\\System32\\OpenSSH;C:\\git-lfs"

# Verify Git + SSH installation
RUN git --version; ssh -V; git lfs version

# Default entrypoint for Harness Git step
CMD ["pwsh", "C:\\bin\\clone.ps1"]