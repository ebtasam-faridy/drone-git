# escape=`

# DEBUG VERSION: Minimal approach with extensive logging
FROM mcr.microsoft.com/windows/servercore:ltsc2022
SHELL ["powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Debug: Show base image information
RUN Write-Host "🐛 DEBUG: Base image information"; `
    Write-Host "🖥️  DEBUG: OS Version: $([System.Environment]::OSVersion)"; `
    Write-Host "🖥️  DEBUG: PowerShell Version: $($PSVersionTable.PSVersion)"; `
    Write-Host "👤 DEBUG: Current User: $([System.Environment]::UserName)"; `
    Write-Host "📁 DEBUG: Working Directory: $(Get-Location)"; `
    Write-Host "💾 DEBUG: Available Disk Space:"; `
    Get-WmiObject -Class Win32_LogicalDisk | Where-Object { $_.DriveType -eq 3 } | Select-Object DeviceID, @{Name="FreeSpace(GB)";Expression={[math]::Round($_.FreeSpace/1GB,2)}}, @{Name="Size(GB)";Expression={[math]::Round($_.Size/1GB,2)}}

# Install OpenSSH Client and download Git with extensive debugging
RUN Write-Host "🔧 DEBUG: Starting installation process"; `
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; `
    # Install OpenSSH Client
    Write-Host "🔐 DEBUG: Installing OpenSSH Client..."; `
    try { `
        $sshCapability = Get-WindowsCapability -Online | Where-Object Name -like "OpenSSH.Client*"; `
        Write-Host "🔍 DEBUG: Available OpenSSH capability: $($sshCapability.Name) - State: $($sshCapability.State)"; `
        if ($sshCapability.State -ne "Installed") { `
            Add-WindowsCapability -Online -Name OpenSSH.Client*; `
            Write-Host "✅ DEBUG: OpenSSH Client installation completed"; `
        } else { `
            Write-Host "ℹ️  DEBUG: OpenSSH Client already installed"; `
        } `
        # Verify OpenSSH installation
        $sshPath = "C:\Windows\System32\OpenSSH\ssh.exe"; `
        if (Test-Path $sshPath) { `
            $sshVersion = & $sshPath -V 2>&1; `
            Write-Host "✅ DEBUG: OpenSSH verified - Version: $sshVersion"; `
            Write-Host "📁 DEBUG: OpenSSH directory contents:"; `
            Get-ChildItem "C:\Windows\System32\OpenSSH" | ForEach-Object { Write-Host "   📄 $($_.Name) ($($_.Length) bytes)" }; `
        } else { `
            Write-Host "❌ DEBUG: OpenSSH installation failed - ssh.exe not found"; `
        } `
    } catch { `
        Write-Host "❌ DEBUG: OpenSSH installation error: $_"; `
    } `
    # Download and install Git + Git LFS
    Write-Host "📥 DEBUG: Downloading Git and Git LFS..."; `
    try { `
        Invoke-WebRequest -UseBasicParsing 'https://github.com/git-for-windows/git/releases/download/v2.39.2.windows.1/MinGit-2.39.2-64-bit.zip' -OutFile 'git.zip'; `
        Write-Host "✅ DEBUG: Git download completed - Size: $((Get-Item 'git.zip').Length) bytes"; `
        Invoke-WebRequest -UseBasicParsing 'https://github.com/git-lfs/git-lfs/releases/download/v3.7.0/git-lfs-windows-amd64-v3.7.0.zip' -OutFile 'git-lfs.zip'; `
        Write-Host "✅ DEBUG: Git LFS download completed - Size: $((Get-Item 'git-lfs.zip').Length) bytes"; `
    } catch { `
        Write-Host "❌ DEBUG: Download error: $_"; `
        throw; `
    } `
    # Extract Git
    Write-Host "📦 DEBUG: Extracting Git..."; `
    try { `
        Expand-Archive -Path 'git.zip' -DestinationPath 'C:\git'; `
        Write-Host "✅ DEBUG: Git extraction completed"; `
        Write-Host "📁 DEBUG: Git directory structure:"; `
        Get-ChildItem 'C:\git' -Recurse -Depth 2 | Where-Object { $_.PSIsContainer } | ForEach-Object { Write-Host "   📁 $($_.FullName)" }; `
    } catch { `
        Write-Host "❌ DEBUG: Git extraction error: $_"; `
        throw; `
    } `
    # Extract Git LFS
    Write-Host "📦 DEBUG: Extracting Git LFS..."; `
    try { `
        Expand-Archive -Path 'git-lfs.zip' -DestinationPath 'git-lfs-temp'; `
        if (-not (Test-Path 'C:\git\cmd')) { New-Item -ItemType Directory -Path 'C:\git\cmd' -Force }; `
        $lfsExe = Get-ChildItem -Path 'git-lfs-temp' -Name 'git-lfs.exe' -Recurse | Select-Object -First 1; `
        if ($lfsExe) { `
            Copy-Item "git-lfs-temp\$lfsExe" 'C:\git\cmd\git-lfs.exe'; `
            Write-Host "✅ DEBUG: Git LFS installed to C:\git\cmd\git-lfs.exe"; `
        } else { `
            Write-Host "⚠️  DEBUG: git-lfs.exe not found in expected location"; `
            Write-Host "📁 DEBUG: Git LFS temp directory contents:"; `
            Get-ChildItem 'git-lfs-temp' -Recurse | ForEach-Object { Write-Host "   📄 $($_.FullName)" }; `
        } `
    } catch { `
        Write-Host "❌ DEBUG: Git LFS extraction error: $_"; `
    } `
    # Cleanup downloads and unnecessary components
    Write-Host "🧹 DEBUG: Cleaning up downloads..."; `
    Remove-Item -Force 'git.zip', 'git-lfs.zip'; `
    Remove-Item -Recurse -Force 'git-lfs-temp'; `
    Write-Host "🧹 DEBUG: Removing unnecessary Git components..."; `
    Remove-Item -Recurse -Force -ErrorAction SilentlyContinue 'C:\git\usr\share\doc', 'C:\git\usr\share\info', 'C:\git\usr\share\man', 'C:\git\usr\share\locale'; `
    # Verify installations
    Write-Host "✅ DEBUG: Verifying installations..."; `
    try { `
        $gitVersion = & 'C:\git\cmd\git.exe' --version; `
        Write-Host "✅ DEBUG: Git verification: $gitVersion"; `
    } catch { `
        Write-Host "❌ DEBUG: Git verification failed: $_"; `
    } `
    try { `
        $lfsVersion = & 'C:\git\cmd\git-lfs.exe' version; `
        Write-Host "✅ DEBUG: Git LFS verification: $lfsVersion"; `
    } catch { `
        Write-Host "❌ DEBUG: Git LFS verification failed: $_"; `
    } `
    try { `
        $sshVersion = & 'C:\Windows\System32\OpenSSH\ssh.exe' -V 2>&1; `
        Write-Host "✅ DEBUG: SSH verification: $sshVersion"; `
    } catch { `
        Write-Host "❌ DEBUG: SSH verification failed: $_"; `
    }

# Add drone-git scripts
ADD windows/* /bin/

# Configure PATH and test final setup
RUN Write-Host "🔧 DEBUG: Configuring PATH..."; `
    $newPath = "$env:PATH;C:\git\cmd;C:\git\mingw64\bin;C:\git\usr\bin;C:\Windows\System32\OpenSSH"; `
    setx /M PATH $newPath; `
    Write-Host "✅ DEBUG: PATH configured: $newPath"; `
    # Test final setup
    Write-Host "🧪 DEBUG: Testing final setup..."; `
    $env:PATH = $newPath; `
    try { `
        $gitTest = & git --version; `
        Write-Host "✅ DEBUG: Final Git test: $gitTest"; `
    } catch { `
        Write-Host "❌ DEBUG: Final Git test failed: $_"; `
    } `
    try { `
        $sshTest = & ssh -V 2>&1; `
        Write-Host "✅ DEBUG: Final SSH test: $sshTest"; `
    } catch { `
        Write-Host "❌ DEBUG: Final SSH test failed: $_"; `
    } `
    Write-Host "🎉 DEBUG: Dockerfile build completed!"

# Set working directory and default command
WORKDIR /
CMD [ "powershell", "C:\\bin\\clone.ps1" ]